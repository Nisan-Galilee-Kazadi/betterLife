# =========================================
# BetterLife Environment Configuration
# =========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# =========================================
# MySQL Database Configuration
# =========================================

# Local XAMPP Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=betterlife_db

# Production cPanel Configuration (à modifier lors du déploiement)
# DB_HOST=your_cpanel_mysql_host
# DB_USER=your_cpanel_username
# DB_PASSWORD=your_cpanel_password
# DB_NAME=your_cpanel_database_name

# =========================================
# Translation APIs Configuration
# =========================================

# Google Translate API (gratuit: 500,000 caractères/mois)
# Obtenir la clé: https://console.cloud.google.com/
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# DeepL API (gratuit: 500,000 caractères/mois)
# Obtenir la clé: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_api_key_here

# =========================================
# Legacy MongoDB (si nécessaire pour migration)
# =========================================
MONGODB_URI=mongodb://localhost:27017/betterlife

# =========================================
# Instructions pour obtenir les clés API
# =========================================

# GOOGLE TRANSLATE API:
# 1. Aller sur https://console.cloud.google.com/
# 2. Créer un nouveau projet ou sélectionner un existant
# 3. Activer l'API "Cloud Translation API"
# 4. Créer des "Credentials" (API Key)
# 5. Copier la clé dans GOOGLE_TRANSLATE_API_KEY

# DEEPL API:
# 1. Aller sur https://www.deepl.com/pro-api
# 2. S'inscrire pour un compte gratuit
# 3. Obtenir la clé API
# 4. Copier la clé dans DEEPL_API_KEY