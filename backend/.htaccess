RewriteEngine On

# Sécurité de base
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"

# Passer les requêtes à l'application Node.js
# Note: Sur certains hébergeurs cPanel, la redirection se fait via "Setup Node.js App"
# Cette règle sert de fallback pour un reverse proxy local si configuré manuellement.
RewriteRule ^(.*)$ http://localhost:5000/$1 [P,L]
